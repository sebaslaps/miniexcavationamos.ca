---
interface Props {
  title: string;
  description: string;
  canonical?: string;
}

const { title, description, canonical = Astro.url.pathname } = Astro.props;
const canonicalUrl = new URL(canonical, Astro.site ?? 'https://example.ca').toString();
const pageTitle = title.includes('Amos') ? title : `${title} | Amos`;
---
<!doctype html>
<html lang="fr-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_CA" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Mini-Excavation Amos" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="robots" content="index, follow" />
    <slot name="head" />
    <style is:global>
      :root {
        color-scheme: light;
        --ink: #172033;
        --muted: #5b6675;
        --brand: #0f6a4f;
        --brand-dark: #074633;
        --accent: #f28c28;
        --sand: #fff4df;
        --soft: #f3f8f4;
        --line: #dce7df;
        --warning: #fff8e8;
        --shadow: 0 22px 65px rgba(23, 32, 51, .12);
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: var(--ink);
        background: #fff;
        line-height: 1.6;
      }
      a { color: var(--brand-dark); }
      .container { width: min(1140px, calc(100% - 32px)); margin: 0 auto; }
      header {
        border-bottom: 1px solid rgba(220, 231, 223, .9);
        background: rgba(255, 255, 255, .94);
        position: sticky;
        top: 0;
        z-index: 10;
        backdrop-filter: blur(16px);
      }
      .nav { min-height: 74px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
      .brand { font-weight: 900; color: var(--ink); text-decoration: none; letter-spacing: -.03em; font-size: 1.05rem; }
      .nav-links { display: flex; align-items: center; gap: 18px; font-size: .95rem; }
      .nav-links a:not(.phone-button) { text-decoration: none; color: var(--muted); font-weight: 750; }
      .button, .phone-button {
        display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        padding: 14px 20px; border-radius: 999px; background: var(--brand); color: white;
        text-decoration: none; font-weight: 900; border: 0; box-shadow: 0 10px 24px rgba(15, 106, 79, .22);
      }
      .button:hover, .phone-button:hover { background: var(--brand-dark); transform: translateY(-1px); }
      .hero {
        padding: 88px 0 58px;
        background:
          radial-gradient(circle at 80% 18%, rgba(242, 140, 40, .18), transparent 28%),
          linear-gradient(135deg, #eef8f2 0%, #ffffff 47%, #e8f2ec 100%);
        overflow: hidden;
      }
      .hero-grid { display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(310px, .88fr); gap: 44px; align-items: center; }
      .hero-copy { position: relative; }
      .hero-copy::before {
        content: ""; position: absolute; inset: -32px auto auto -34px; width: 82px; height: 82px;
        background: var(--accent); border-radius: 28px; opacity: .16; transform: rotate(12deg); z-index: 0;
      }
      .hero-copy > * { position: relative; z-index: 1; }
      .eyebrow { color: var(--brand-dark); font-weight: 950; text-transform: uppercase; letter-spacing: .09em; font-size: .78rem; margin: 0 0 10px; }
      h1 { font-size: clamp(2.55rem, 6vw, 5.15rem); line-height: .95; letter-spacing: -.075em; margin: 10px 0 22px; max-width: 880px; }
      h2 { font-size: clamp(1.75rem, 3vw, 2.65rem); line-height: 1.06; letter-spacing: -.045em; margin: 0 0 16px; }
      h3 { font-size: 1.18rem; margin: 0 0 8px; letter-spacing: -.02em; }
      .lead { font-size: 1.18rem; color: var(--muted); max-width: 720px; }
      .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 14px; margin: 28px 0 18px; }
      .callout { color: var(--brand-dark); background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 10px 14px; font-weight: 800; }
      .trust-list { display: flex; flex-wrap: wrap; gap: 10px; list-style: none; padding: 0; margin: 20px 0 0; }
      .trust-list li { margin: 0; padding: 9px 12px; border: 1px solid var(--line); background: rgba(255,255,255,.75); border-radius: 999px; font-weight: 800; color: var(--ink); }
      .card { border: 1px solid var(--line); border-radius: 30px; padding: 30px; background: white; box-shadow: var(--shadow); }
      .cta-card { background: linear-gradient(160deg, var(--ink), #0b3b31); color: white; }
      .cta-card p { color: rgba(255,255,255,.82); }
      .cta-card .eyebrow { color: #9ee0c4; }
      .cta-card .phone-button { background: #fff; color: var(--brand-dark); width: 100%; margin: 14px 0; box-shadow: none; }
      .small { font-size: .92rem; color: var(--muted); }
      .cta-card .small { color: rgba(255,255,255,.72); }
      section { padding: 68px 0; }
      .section-head > .lead { margin-bottom: 28px; }
      .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
      .grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 28px; align-items: start; }
      .feature { border: 1px solid var(--line); border-radius: 24px; padding: 24px; background: #fff; box-shadow: 0 10px 28px rgba(23, 32, 51, .05); }
      .feature p { color: var(--muted); margin-bottom: 0; }
      .soft { background: var(--soft); }
      .problem-strip { padding: 0; background: var(--ink); color: white; }
      .strip-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: rgba(255,255,255,.14); }
      .strip-grid p { margin: 0; padding: 22px 18px; background: var(--ink); font-weight: 800; }
      .notice { background: var(--warning); border: 1px solid #ead69b; border-radius: 24px; padding: 24px 26px; }
      .map-card { background: linear-gradient(180deg, #ffffff, var(--sand)); }
      .final-cta { border-left: 5px solid var(--accent); padding-left: 24px; }
      ul.clean { padding-left: 1.2rem; }
      .service-area { columns: 2; }
      .steps { padding-left: 1.2rem; }
      li { margin: .4rem 0; }
      label { display: grid; gap: 6px; margin: 0 0 14px; font-weight: 800; color: var(--ink); }
      input, textarea { width: 100%; border: 1px solid var(--line); border-radius: 14px; padding: 12px 14px; font: inherit; color: var(--ink); background: #fff; }
      textarea { resize: vertical; }
      button.button { cursor: pointer; }
      footer { padding: 34px 0; border-top: 1px solid var(--line); color: var(--muted); }
      @media (max-width: 900px) {
        .hero-grid, .grid-2, .grid-3, .strip-grid { grid-template-columns: 1fr; }
        .nav { align-items: flex-start; flex-direction: column; padding: 16px 0; }
        .nav-links { flex-wrap: wrap; }
        .hero { padding-top: 54px; }
        .service-area { columns: 1; }
      }
    </style>
  </head>
  <body>
    <header>
      <nav class="container nav" aria-label="Navigation principale">
        <a class="brand" href="/">Mini-Excavation Amos</a>
        <div class="nav-links">
          <a href="/#services">Services</a>
          <a href="/#secteurs">Secteurs desservis</a>
          <slot name="nav-cta" />
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <div class="container">
        <p>Mini-Excavation Amos — drainage, terrassement, fondation et nivellement.</p>
        <p class="small">© 2026 Mini-Excavation Amos. Tous droits réservés.</p>
      </div>
    </footer>
  </body>
</html>
